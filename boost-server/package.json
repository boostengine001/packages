{
  "name": "@boostengine/server",
  "version": "1.1.0",
  "description": "Plug-and-Play Headless eCommerce API Router for Express, Fastify, and Hono. 1-line auto-mount for Payments, Logistics, Returns, Coupons, Phone Auth, and GST Invoicing.",
  "author": "Boost Engine <boostengine001@gmail.com>",
  "license": "MIT",
  "keywords": [
    "ecommerce-server",
    "express-ecommerce",
    "headless-api",
    "payment-webhooks",
    "shipping-api",
    "otp-auth",
    "gst-invoicing",
    "boostengine"
  ],
  "homepage": "https://github.com/boostengine/boostengine/tree/main/packages/boost-server#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/boostengine/boostengine.git",
    "directory": "packages/boost-server"
  },
  "bugs": {
    "url": "https://github.com/boostengine/boostengine/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.mjs",
      "require": "./dist/fastify.cjs"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.mjs",
      "require": "./dist/hono.cjs"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.mjs",
      "require": "./dist/ai.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node test-suite.cjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@boostengine/auth": "^1.0.0",
    "@boostengine/cart": "^1.0.0",
    "@boostengine/coupons": "^1.0.0",
    "@boostengine/invoicing": "^1.0.0",
    "@boostengine/notifications": "^1.0.0",
    "@boostengine/payments": "^1.1.0",
    "@boostengine/returns": "^1.0.0",
    "@boostengine/shipping": "^1.0.0"
  },
  "peerDependencies": {
    "express": ">=4.18.0",
    "fastify": ">=4.0.0",
    "hono": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "express": "^5.2.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
