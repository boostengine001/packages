{
  "name": "@boostengine/gamification",
  "version": "1.1.0",
  "description": "Interactive eCommerce gamification engine: Lucky Spin-the-Wheel, Scratch-to-Reveal Cards, Mystery Gift Boxes, exit-intent lead capture, and AI reward optimization.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "boost-gamification": "./bin/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.mjs",
      "require": "./dist/agent.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node test-suite.cjs",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "tsup"
  },
  "keywords": [
    "boostengine",
    "ecommerce",
    "gamification",
    "spin-wheel",
    "scratch-card",
    "mystery-box",
    "exit-intent",
    "lead-generation",
    "coupons",
    "react-hooks",
    "d2c"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boostengine/boostengine.git"
  },
  "author": "BoostEngine Team",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
