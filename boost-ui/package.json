{
  "name": "@boostengine/ui",
  "version": "2.1.6",
  "description": "Universal, Zero-Config UI Component Suite for Next.js & React. Build High-Converting eCommerce, Modern SaaS, Enterprise Dashboards, and Landing Pages with AI Agent Native Support.",
  "author": "Rishabh Gehlot <boostengine001@gmail.com> (https://github.com/Rishabhgehlot7)",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Rishabhgehlot7"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "react-ui",
    "nextjs-ui",
    "ui-components",
    "ecommerce-ui",
    "saas-ui",
    "dashboard-ui",
    "landing-page-components",
    "zero-config",
    "zero-dependency",
    "dark-mode",
    "theming",
    "design-system",
    "shadcn-alternative",
    "radix-ui",
    "tailwind-free",
    "ai-agent-friendly",
    "llms-txt",
    "cart-drawer",
    "product-gallery",
    "pricing-table",
    "hero-section",
    "command-palette",
    "d2c",
    "headless-commerce",
    "react-hooks",
    "utility-functions",
    "useMediaQuery",
    "useCopyToClipboard",
    "useForm",
    "formatCurrency",
    "indian-ecommerce",
    "upi-checkout",
    "svg-charts",
    "accessible-ui"
  ],
  "homepage": "https://github.com/boostengine001/packages/tree/main/boost-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boostengine001/packages.git",
    "directory": "boost-ui"
  },
  "bugs": {
    "url": "https://github.com/boostengine001/packages/issues"
  },
  "bin": {
    "boost-ui": "./bin/cli.cjs",
    "ui": "./bin/cli.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.json": "./dist/tokens.json",
    "./hooks": {
      "import": {
        "types": "./dist/hooks/index.d.mts",
        "default": "./dist/hooks/index.mjs"
      },
      "require": {
        "types": "./dist/hooks/index.d.ts",
        "default": "./dist/hooks/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.mts",
        "default": "./dist/utils/index.mjs"
      },
      "require": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte/index.d.mts",
        "default": "./dist/svelte/index.mjs"
      },
      "require": {
        "types": "./dist/svelte/index.d.ts",
        "default": "./dist/svelte/index.cjs"
      }
    },
    "./solid": {
      "import": {
        "types": "./dist/solid/index.d.mts",
        "default": "./dist/solid/index.mjs"
      },
      "require": {
        "types": "./dist/solid/index.d.ts",
        "default": "./dist/solid/index.cjs"
      }
    },
    "./angular": {
      "import": {
        "types": "./dist/angular/index.d.mts",
        "default": "./dist/angular/index.mjs"
      },
      "require": {
        "types": "./dist/angular/index.d.ts",
        "default": "./dist/angular/index.cjs"
      }
    },
    "./qwik": {
      "import": {
        "types": "./dist/qwik/index.d.mts",
        "default": "./dist/qwik/index.mjs"
      },
      "require": {
        "types": "./dist/qwik/index.d.ts",
        "default": "./dist/qwik/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next/index.d.mts",
        "default": "./dist/next/index.mjs"
      },
      "require": {
        "types": "./dist/next/index.d.ts",
        "default": "./dist/next/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue/index.d.mts",
        "default": "./dist/vue/index.mjs"
      },
      "require": {
        "types": "./dist/vue/index.d.ts",
        "default": "./dist/vue/index.cjs"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/web/index.d.mts",
        "default": "./dist/web/index.mjs"
      },
      "require": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native/index.d.mts",
        "default": "./dist/native/index.mjs"
      },
      "require": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite/index.d.mts",
        "default": "./dist/vite/index.mjs"
      },
      "require": {
        "types": "./dist/vite/index.d.ts",
        "default": "./dist/vite/index.cjs"
      }
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens/index.d.mts",
        "default": "./dist/tokens/index.mjs"
      },
      "require": {
        "types": "./dist/tokens/index.d.ts",
        "default": "./dist/tokens/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "src/components",
    "!src/components/__tests__",
    "src/tokens.json",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node test-suite.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:smoke",
    "size": "size-limit",
    "publint": "publint",
    "build:showcase": "esbuild visual/showcase.tsx --bundle --outfile=visual/showcase.js --jsx=automatic --platform=browser --minify",
    "test:visual": "playwright test",
    "docs": "ladle serve",
    "docs:build": "ladle build",
    "docs:build:pages": "ladle build --viteConfig ./vite.pages.config.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^22.1.7",
    "@builder.io/qwik": "^1.20.0",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "30.1.1",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.87.1",
    "rxjs": "^7.8.2",
    "size-limit": "^14.1.0",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "5.0.3",
    "vue": "^3.5.43"
  },
  "size-limit": [
    {
      "name": "Full bundle (ESM)",
      "path": "dist/index.mjs",
      "limit": "100 kB"
    },
    {
      "name": "Utils only (treeshaken)",
      "path": "dist/index.mjs",
      "import": "{ cn, formatCurrency }",
      "limit": "10 kB"
    },
    {
      "name": "Hooks (treeshaken)",
      "path": "dist/index.mjs",
      "import": "{ useForm, useMediaQuery }",
      "limit": "15 kB"
    }
  ],
  "type": "commonjs"
}
