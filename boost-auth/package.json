{
  "name": "@boostengine/auth",
  "version": "1.2.0",
  "description": "Universal, zero-dependency authentication framework for Next.js, React Native, Node.js, Express, and AI Agents with Phone OTP, WhatsApp, OAuth, Database Adapters, and React Hooks.",
  "author": "Boost Engine <boostengine001@gmail.com>",
  "license": "MIT",
  "keywords": [
    "auth",
    "next-auth",
    "authjs",
    "better-auth",
    "otp",
    "phone-auth",
    "whatsapp-auth",
    "oauth",
    "google-auth",
    "github-auth",
    "apple-auth",
    "react-native-auth",
    "expo-auth",
    "ecommerce-auth",
    "jwt",
    "nextjs-auth",
    "guest-checkout",
    "guest-cart-merge",
    "stateless-auth",
    "prisma-auth",
    "drizzle-auth",
    "mongodb-auth",
    "session-cookies",
    "ai-agent",
    "agent-toolkit"
  ],
  "homepage": "https://github.com/boostengine/boostengine/tree/main/packages/boost-auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boostengine/boostengine.git",
    "directory": "packages/boost-auth"
  },
  "bugs": {
    "url": "https://github.com/boostengine/boostengine/issues"
  },
  "bin": {
    "boost-auth": "./bin/cli.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.mjs",
      "require": "./dist/adapters.cjs"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.mjs",
      "require": "./dist/providers.cjs"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.mjs",
      "require": "./dist/agent.cjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node test-suite.cjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2"
  }
}
