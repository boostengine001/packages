{
  "name": "@boostengine/loyalty",
  "version": "1.1.0",
  "description": "Enterprise-grade Loyalty Engine — SuperCoins, VIP Tiers, Gamification, Challenges & AI Agent Toolkit for Next.js, Vite, React, and Node.js.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.mjs",
      "require": "./dist/agent.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "bin": {
    "boost-loyalty": "./bin/cli.cjs"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "node test-suite.cjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "loyalty",
    "supercoins",
    "rewards",
    "cashback",
    "vip-tiers",
    "gamification",
    "challenges",
    "leaderboard",
    "event-driven",
    "ai-agent",
    "ecommerce",
    "nextjs",
    "vite",
    "react",
    "d2c",
    "boostengine"
  ],
  "author": "Boost Engine <boostengine001@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boostengine/boostengine.git",
    "directory": "packages/boost-loyalty"
  },
  "homepage": "https://github.com/boostengine/boostengine#readme",
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2"
  }
}
