# Boost Engine Vite + React D2C Storefront Configuration
VITE_STORE_NAME="{{BRAND_TITLE}}"
VITE_STORE_TAGLINE="Premium Indian D2C Streetwear & Apparel"

# Backend API Configuration
# Local dev default proxies to backend-express (http://localhost:3001)
VITE_API_BASE_URL=/api

# Payment Gateway (Razorpay Indian Payments & UPI)
# Optional in Mock Mode. Set your live or test key from Razorpay Dashboard.
VITE_RAZORPAY_KEY_ID=rzp_test_mock_mode

# Customer Support
VITE_SUPPORT_EMAIL=support@booststore.in
VITE_SUPPORT_PHONE=+919876543210
