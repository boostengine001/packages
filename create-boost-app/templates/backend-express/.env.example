PORT=3001
# Set to true for instant test mode without API keys (test OTP: 1234, simulated payments & pincodes)
MOCK_MODE=true

# ── CORS & Allowed Client URLs ────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Database (MongoDB) ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/boost_store?retryWrites=true&w=majority

# ── Razorpay (Payment Gateway) ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Cashfree (Payment Gateway) ────────────────────────────────────────────────
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# ── PhonePe (Payment Gateway) ─────────────────────────────────────────────────
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
PHONEPE_SALT_KEY=your_phonepe_salt_key
PHONEPE_SALT_INDEX=1

# ── Shiprocket (Logistics) ─────────────────────────────────────────────────────
SHIPROCKET_EMAIL=you@yourdomain.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# ── Fast2SMS (OTP Authentication) ─────────────────────────────────────────────
FAST2SMS_API_KEY=your_fast2sms_api_key

# ── GST / Business ────────────────────────────────────────────────────────────
GST_NUMBER=29ABCDE1234F1Z5
BUSINESS_NAME={{BRAND_TITLE}}

# ── JWT (if using custom auth) ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
