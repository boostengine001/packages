{
  "name": "boost-express-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Node.js/Express eCommerce REST API with Indian GST, Razorpay, COD, and dual MongoDB/Mock mode",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "test": "ts-node-dev --transpile-only tests/run-all-tests.ts"
  },
  "dependencies": {
    "@boostengine/server": "^1.1.0",
    "@boostengine/core": "^1.1.0",
    "@boostengine/payments": "^1.2.0",
    "@boostengine/shipping": "^1.1.0",
    "@boostengine/invoicing": "^1.1.0",
    "@boostengine/returns": "^1.1.0",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "mongoose": "^8.5.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.14.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/sharp": "^0.31.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
