# ==============================================================================
# Boost D2C Store - Environment Variables Template
# ==============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (MongoDB) — optional. Leave commented to run on the in-memory store.
# Uncomment ONLY if you actually have MongoDB running locally, otherwise every
# request pays a ~5s connection timeout before falling back.
MONGODB_URI=mongodb://localhost:27017/boost-store

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Cashfree (Payment Gateway)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# PhonePe (Payment Gateway)
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
PHONEPE_SALT_KEY=your_phonepe_salt_key
PHONEPE_SALT_INDEX=1

# Logistics & Courier Partners
SHIPROCKET_EMAIL=you@yourdomain.com
SHIPROCKET_PASSWORD=your_shiprocket_password
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_CLIENT_NAME=your_client_name

# JWT Auth & Session
JWT_SECRET=your_super_secret_jwt_key_here

# Cloud Storage (AWS S3)
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_AWS_BUCKET_NAME=your-bucket-name
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=your_access_key
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=your_secret_key

# Omnichannel Communications (WhatsApp & SMS)
INTERAKT_API_KEY=your_interakt_whatsapp_api_key
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_access_token
FAST2SMS_API_KEY=your_fast2sms_api_key
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=BOOSTN

# Email Notifications (Resend / SMTP)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
