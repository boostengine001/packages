{
  "name": "@boostengine/recommendations",
  "version": "1.1.0",
  "description": "Enterprise Frequently Bought Together (FBT) bundles, Collaborative Filtering, Cart Cross-Sells, Smart Upsells, and Autonomous AI Recommendation Tools.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "boost-recommendations": "./bin/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.mjs",
      "require": "./dist/agent.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node test-suite.cjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "recommendations",
    "frequently-bought-together",
    "cross-sell",
    "upsell",
    "bundle-deals",
    "collaborative-filtering",
    "ai-agent",
    "react-hooks",
    "average-order-value",
    "ecommerce",
    "boostengine"
  ],
  "author": "Boost Engine <boostengine001@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boostengine/boostengine.git",
    "directory": "packages/boost-recommendations"
  },
  "homepage": "https://github.com/boostengine/boostengine#readme",
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2"
  }
}
