{
  "name": "@boostengine/inventory",
  "version": "1.1.0",
  "description": "Ultra-fast headless eCommerce inventory engine with flash-sale stock lock (TTL), proximity multi-warehouse routing, split shipments, safety stock buffers, backorders, AI agent toolkit, and universal React/React Native hooks.",
  "author": "Boost Engine <boostengine001@gmail.com>",
  "license": "MIT",
  "keywords": [
    "inventory",
    "stock",
    "low-stock-urgency",
    "multi-warehouse",
    "stock-reservation",
    "ecommerce-inventory",
    "flash-sale",
    "split-shipment",
    "backorders",
    "ai-agent",
    "react-hooks",
    "nextjs",
    "react-native"
  ],
  "homepage": "https://github.com/boostengine/boostengine/tree/main/packages/boost-inventory#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/boostengine/boostengine.git",
    "directory": "packages/boost-inventory"
  },
  "bugs": {
    "url": "https://github.com/boostengine/boostengine/issues"
  },
  "bin": {
    "boost-inventory": "./bin/cli.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.mjs",
      "require": "./dist/agent.cjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node test-suite.cjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
